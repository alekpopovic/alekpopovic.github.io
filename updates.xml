---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"><title>{{ site.title | xml_escape }} — Site updates</title><id>{{ '/updates.xml' | absolute_url }}</id><link href="{{ '/updates.xml' | absolute_url }}" rel="self"/><link href="{{ '/updates/' | absolute_url }}"/><updated>{{ site.data.updates.first.date | date_to_xmlschema }}</updated>{% for update in site.data.updates %}<entry><title>{{ update.title | xml_escape }}</title><id>{{ '/updates/#' | append: update.id | absolute_url }}</id><link href="{{ update.url | absolute_url }}"/><updated>{{ update.date | date_to_xmlschema }}</updated><summary>{{ update.description | xml_escape }}</summary><author><name>{{ site.author.name | xml_escape }}</name></author></entry>{% endfor %}</feed>
