+func checkSchemaVersion(value string) error {
+	normalized := strings.TrimLeft(strings.TrimSpace(value), "0")
+	if normalized == "" {
+		normalized = "0"
+	}
+	current, err := strconv.Atoi(normalized)
+	if err != nil {
