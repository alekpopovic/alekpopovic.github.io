+func TestRootCommandConstruction(t *testing.T) {
+	root := NewRootCommand(Options{})
+
+	for _, path := range []string{
+		"version",
+		"node ls",
+		"node inspect",
+		"node drain",
+		"node uncordon",
+		"deploy",
+		"service ls",
+		"service inspect",
+		"service ps",
+		"scale",
+		"rollout",
+		"rollback",
+		"delete",
+		"events",
+		"logs",
+	} {
+		if _, _, err := root.Find(strings.Fields(path)); err != nil {
+			t.Fatalf("expected command %q: %v", path, err)
+		}
+	}
+}
