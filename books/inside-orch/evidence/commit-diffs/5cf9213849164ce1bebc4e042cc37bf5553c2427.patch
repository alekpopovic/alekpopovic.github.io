+		pair := strings.SplitN(part, "=", 2)
+		if len(pair) != 2 {
+			continue
+		}
+		labelKey := strings.TrimSpace(pair[0])
+		labelValue := strings.TrimSpace(pair[1])
+		if labelKey != "" {
+			labels[labelKey] = labelValue
+		}
+	}
+	return labels
+}
