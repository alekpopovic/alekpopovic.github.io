+services:
+  postgres:
+    image: postgres:16-alpine
+    environment:
+      POSTGRES_DB: orch
+      POSTGRES_USER: orch
+      POSTGRES_PASSWORD: orch
+    ports:
+      - "5432:5432"
+    volumes:
+      - postgres-data:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U orch -d orch"]
+      interval: 5s
+      timeout: 3s
+      retries: 10
+
+  orch-server:
+    build:
+      context: .
+      dockerfile: deployments/examples/Dockerfile
+      args:
+        TARGET: orch-server
+    profiles: ["local-orch"]
+    environment:
+      DATABASE_URL: postgres://orch:orch@postgres:5432/orch?sslmode=disable
+      ORCH_SERVER_ADDR: :8080
+      ORCH_AGENT_REGISTRATION_TOKEN: ${ORCH_AGENT_REGISTRATION_TOKEN:-dev-registration-token}
+      ORCH_JWT_SECRET: ""
+      ORCH_SECRET_KEY: ${ORCH_SECRET_KEY:-dev-secret-key-change-me}
+      ORCH_NODE_HEARTBEAT_TIMEOUT: ${ORCH_NODE_HEARTBEAT_TIMEOUT:-30s}
+      ORCH_NODE_MONITOR_INTERVAL: ${ORCH_NODE_MONITOR_INTERVAL:-5s}
+      ORCH_LOG_LEVEL: ${ORCH_LOG_LEVEL:-info}
+    ports:
+      - "8080:8080"
+    depends_on:
+      postgres:
+        condition: service_healthy
+
+  orch-agent:
+    build:
+      context: .
+      dockerfile: deployments/examples/Dockerfile
+      args:
+        TARGET: orch-agent
+    profiles: ["local-orch"]
+    environment:
+      ORCH_SERVER_URL: http://orch-server:8080
+      ORCH_AGENT_REGISTRATION_TOKEN: ${ORCH_AGENT_REGISTRATION_TOKEN:-dev-registration-token}
+      ORCH_NODE_NAME: ${ORCH_NODE_NAME:-local-agent-1}
+      ORCH_AGENT_ADDR: :8081
+      ORCH_ADVERTISE_ADDRESS: http://orch-agent:8081
+      ORCH_NODE_LABELS: ${ORCH_NODE_LABELS:-role=worker}
+      ORCH_DOCKER_SOCKET: ${ORCH_DOCKER_SOCKET:-/var/run/docker.sock}
+      ORCH_LOG_LEVEL: ${ORCH_LOG_LEVEL:-info}
+      ORCH_AGENT_HEARTBEAT_INTERVAL: ${ORCH_AGENT_HEARTBEAT_INTERVAL:-5s}
+    ports:
+      - "8081:8081"
+    volumes:
+      - /var/run/docker.sock:/var/run/docker.sock
+    depends_on:
+      - orch-server
+
+  traefik:
+    image: traefik:v3.1
+    profiles: ["traefik"]
+    command:
+      - --api.insecure=true
+      - --entrypoints.web.address=:80
+      - --entrypoints.websecure.address=:443
+      - --providers.http.endpoint=http://orch-server:8080/v1/integrations/traefik/config
+      - --providers.http.pollInterval=2s
+    ports:
+      - "8088:8080"
+      - "8082:80"
+      - "8443:443"
+    depends_on:
+      - orch-server
+
+  demo-app:
+    image: nginx:1.27-alpine
+    profiles: ["demo"]
+    ports:
+      - "18080:80"
+
+  postgres-exporter:
+    image: prometheuscommunity/postgres-exporter:latest
+    profiles: ["monitoring"]
+    environment:
+      DATA_SOURCE_NAME: postgres://orch:orch@postgres:5432/orch?sslmode=disable
+    depends_on:
+      postgres:
+        condition: service_healthy
+
+  prometheus:
+    image: ${PROMETHEUS_IMAGE:-prom/prometheus:latest}
+    profiles: ["monitoring"]
+    command:
+      - --config.file=/etc/prometheus/prometheus.yml
+      - --storage.tsdb.path=/prometheus
+    ports:
+      - "9090:9090"
+    volumes:
+      - ./deploy/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
+      - ./deploy/monitoring/prometheus-rules.yaml:/etc/prometheus/rules/prometheus-rules.yaml:ro
+      - prometheus-data:/prometheus
+    depends_on:
+      - orch-server
+      - orch-agent
+      - postgres-exporter
+
+volumes:
+  postgres-data:
+  prometheus-data:
