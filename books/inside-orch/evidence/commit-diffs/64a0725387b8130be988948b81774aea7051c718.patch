+	service, err := s.controlPlane.ScaleService(r.Context(), id, req.Replicas)
+	if err != nil {
+		s.writeError(w, r, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, ServiceResponse{Service: service})
