+Requires=docker.service
+
+[Service]
+Type=simple
+User=orch-agent
+Group=orch-agent
+SupplementaryGroups=docker
+EnvironmentFile=/etc/orch/orch-agent.env
+ExecStart=/usr/local/bin/orch-agent
+Restart=always
+RestartSec=5s
+TimeoutStopSec=30s
+KillSignal=SIGTERM
+NoNewPrivileges=true
+PrivateTmp=true
+ProtectHome=true
+ProtectSystem=strict
