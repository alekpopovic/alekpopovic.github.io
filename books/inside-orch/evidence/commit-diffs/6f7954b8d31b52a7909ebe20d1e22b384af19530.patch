+func validImageReference(image string) bool {
+	image = strings.TrimSpace(image)
+	if image == "" || strings.Contains(image, "://") || strings.HasPrefix(image, "-") {
+		return false
+	}
+	for _, char := range image {
+		if char <= ' ' || char == '"' || char == '\'' {
+			return false
+		}
+	}
+	return true
+}
