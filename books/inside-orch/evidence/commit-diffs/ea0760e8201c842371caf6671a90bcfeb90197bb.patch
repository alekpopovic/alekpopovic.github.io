+func (route Route) Validate() error {
+	if strings.TrimSpace(route.Host) == "" {
+		return fmt.Errorf("host is required")
+	}
+	if strings.TrimSpace(route.PathPrefix) == "" {
+		return fmt.Errorf("path_prefix is required")
