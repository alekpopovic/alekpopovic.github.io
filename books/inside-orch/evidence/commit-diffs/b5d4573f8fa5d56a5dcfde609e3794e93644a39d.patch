+	case message == "":
+		message = "server returned " + e.Status
+	}
+	if details := formatDetails(e.Details); details != "" {
+		message += " (" + details + ")"
+	}
+	if e.RequestID != "" {
+		message += " [request_id=" + e.RequestID + "]"
+	}
+	return message
+}
