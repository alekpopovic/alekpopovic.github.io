+	Details    map[string]any
+}
+
+func (e *APIError) Error() string {
+	if e == nil {
+		return ""
+	}
+	code := strings.ReplaceAll(strings.TrimSpace(e.Code), "_", " ")
+	message := strings.TrimSpace(e.Message)
+	switch {
+	case code != "" && message != "":
+		message = code + ": " + message
+	case code != "":
