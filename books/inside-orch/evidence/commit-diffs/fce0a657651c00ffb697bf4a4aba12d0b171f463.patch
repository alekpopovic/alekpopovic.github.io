+func pendingTask(id types.TaskID, serviceID types.ServiceID) types.Task {
+	return types.Task{
+		ID:            id,
+		ServiceID:     serviceID,
+		DesiredStatus: types.TaskRunning,
+		ActualStatus:  types.TaskPending,
