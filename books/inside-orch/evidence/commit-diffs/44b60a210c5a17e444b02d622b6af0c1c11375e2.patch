+func consumesResources(task types.Task) bool {
+	if task.NodeID == "" {
+		return false
+	}
+	if task.DesiredStatus == types.TaskRemoved {
+		return false
+	}
+	switch task.ActualStatus {
+	case types.TaskPending,
+		types.TaskAssigned,
+		types.TaskPulling,
+		types.TaskCreated,
+		types.TaskStarting,
+		types.TaskRunning,
+		types.TaskHealthy,
+		types.TaskUnhealthy,
+		types.TaskStopping:
+		return true
+	default:
+		return false
+	}
+}
