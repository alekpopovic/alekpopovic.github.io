+    last_schedule_at TIMESTAMPTZ,
+    next_schedule_at TIMESTAMPTZ,
+    created_at TIMESTAMPTZ NOT NULL,
+    updated_at TIMESTAMPTZ NOT NULL,
+    UNIQUE(namespace, name)
