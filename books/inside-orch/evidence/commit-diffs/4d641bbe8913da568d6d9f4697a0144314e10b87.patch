+func (s *MemoryService) SetNotificationDispatcher(dispatcher interface {
+	Notify(context.Context, types.Event) error
+}) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.notificationDispatcher = dispatcher
+}
