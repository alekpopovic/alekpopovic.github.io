+func scanService(row pgx.Row) (types.Service, error) {
+	var service types.Service
+	var id string
+	var env, secretRefs, ports, requirements, restartPolicy, constraints []byte
+	var healthcheck []byte
+	err := row.Scan(
+		&id,
+		&service.Spec.Name,
+		&service.Spec.Image,
+		&service.Spec.Replicas,
+		&env,
+		&secretRefs,
+		&ports,
+		&requirements,
