+func scanNode(row pgx.Row) (types.Node, error) {
+	var node types.Node
+	var id string
+	var labels []byte
+	err := row.Scan(
+		&id,
+		&node.Hostname,
+		&node.AdvertiseAddress,
+		&labels,
+		&node.Capacity.CPU,
+		&node.Capacity.Memory,
