+		values.Set("type", filter.Type)
+	}
+	if filter.Severity != "" {
+		values.Set("severity", string(filter.Severity))
+	}
+	if !filter.Since.IsZero() {
+		values.Set("since", filter.Since.UTC().Format(time.RFC3339Nano))
+	}
+	if filter.Limit > 0 {
+		values.Set("limit", strconv.Itoa(filter.Limit))
+	}
+	return values
