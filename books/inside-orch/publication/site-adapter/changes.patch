+for command in [[sys.executable,str(BOOK/'scripts/verify_pack.py')],[sys.executable,str(BOOK/'scripts/check_manuscript.py'),'--strict']]:
+    result=subprocess.run(command,cwd=SITE,capture_output=True,text=True)
